{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "dev.krusch/krusch-coding-harness",
  "description": "Two-phase commit coding harness that stages diffs, runs sandboxed tests, and applies atomically.",
  "repository": {
    "url": "https://github.com/kruschdev/krusch-coding-harness",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "krusch-coding-harness",
      "version": "0.2.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
